    local function playSelectedQueueIndex()
        local trackNode = sessionQueue[currentQueueIndex]
        if not trackNode then return end
        
        prestineDisconnect()
        
        BrowserPanel.Visible = false
        PlayerPanel.Visible = true
        
        ContentRack.Visible = false
        LoaderFrame.Visible = true
        networkStreamLoadingActive = true
        
        TrackNameLabel.Text = trackNode.title
        ArtistLabel.Text = "By " .. trackNode.channel
        ProgressBar.Size = UDim2.new(0, 0, 1, 0)
        TimeCurrent.Text = "00:00"
        TimeTotal.Text = "00:00"
        PauseBtn.Text = "⏸ PAUSE"
        
        local favs = getSavedFavorites()
        local isFav = false
        for _, f_item in ipairs(favs) do
            if f_item.id == trackNode.id then isFav = true; break end
        end
        ToggleFavBtn.Text = isFav and "★" or "☆"
        ToggleFavBtn.TextColor3 = Color3.fromRGB(255, 255, 255) 
        
        StatusText.Text = "⏳ Requesting secure connection from RapidAPI..."
        StatusText.TextColor3 = Color3.fromRGB(0, 255, 255)
        
        task.spawn(function()
            local spinChars = {"◐", "◓", "◑", "◒"}
            local frameTicks = 0
            local barTweenInfo = TweenInfo.new(0.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)
            LoaderBarGlow.Position = UDim2.new(0, 0, 0, 0)
            local activeBarTween = g:Create(LoaderBarGlow, barTweenInfo, {Position = UDim2.new(0.7, 0, 0, 0)})
            activeBarTween:Play()
            
            while networkStreamLoadingActive do
                frameTicks = frameTicks + 1
                local charSymbol = spinChars[(frameTicks % #spinChars) + 1]
                local dotSequence = string.rep(".", (frameTicks % 4))
                LoaderText.Text = charSymbol .. "  ᴅᴏᴡɴʟᴏᴀᴅɪɴɢ   ᴀᴜᴅɪᴏ   ʙʏᴛᴇs" .. dotSequence
                task.wait(0.14)
            end
            activeBarTween:Cancel()
        end)
        
        task.spawn(function()
            local linkUrl = "https://" .. downloadHost .. "/dl?id=" .. trackNode.id
            local finalLink = nil
            local retryCount = 0
            
            while retryCount < 15 and networkStreamLoadingActive do
                local success, res = pcall(function()
                    return n({
                        Url = linkUrl,
                        Method = "GET",
                        Headers = {
                            ["X-RapidAPI-Host"] = downloadHost,
                            ["X-RapidAPI-Key"] = getSecureKey(),
                            ["Content-Type"] = "application/json"
                        }
                    })
                end)
                
                if success and res and res.StatusCode == 200 then
                    local decodeOk, data = pcall(function() return f:JSONDecode(res.Body) end)
                    if decodeOk and data then
                        if data.status == "ok" and data.link then
                            finalLink = data.link
                            break
                        elseif data.status == "processing" or data.msg == "in queue" then
                            StatusText.Text = "⏳ Audio is rendering on API Node... (" .. retryCount .. ")"
                            task.wait(2.5)
                            retryCount = retryCount + 1
                        else
                            StatusText.Text = "❌ API Format Error: " .. tostring(data.msg or "Blocked")
                            break
                        end
                    else
                        StatusText.Text = "❌ API Error: Invalid JSON (Executor blocked or Limit Hit)"
                        break
                    end
                else
                    StatusText.Text = "❌ Network Request Failed."
                    break
                end
            end
            
            if finalLink and networkStreamLoadingActive then
                StatusText.Text = "📥 Injecting audio byte stream into executor..."
                local fileOk, buffer = pcall(function()
                    return n({Url = finalLink, Method = "GET"})
                end)
                
                if fileOk and buffer and buffer.StatusCode == 200 then
                    local targetLocalFile = "ZaynStudio_StreamTrack.mp3"
                    pcall(function() if writefile then writefile(targetLocalFile, buffer.Body) end end)
                    task.wait(0.1)
                    
                    local assetOk, localAssetToken = pcall(function() return getcustomasset(targetLocalFile) end)
                    
                    if assetOk and localAssetToken then
                        if GlobalSound.IsPlaying then GlobalSound:Stop() end
                        
                        local playOk, playErr = pcall(function()
                            GlobalSound.SoundId = localAssetToken
                            GlobalSound:Play()
                        end)
                        
                        if playOk then
                            networkStreamLoadingActive = false
                            LoaderFrame.Visible = false
                            ContentRack.Visible = true
                            StatusText.Text = "🔊 Audio Active Engine Stream Synced."
                            StatusText.TextColor3 = Color3.fromRGB(0, 255, 255)
                            
                            heartbeatConn = h.Heartbeat:Connect(function()
                                if not seekBlockInteraction and (GlobalSound.IsPlaying or GlobalSound.TimePosition > 0) then
                                    local len = GlobalSound.TimeLength
                                    local pos = GlobalSound.TimePosition
                                    if len > 0 then
                                        local pct = math.clamp(pos / len, 0, 1)
                                        ProgressBar.Size = UDim2.new(pct, 0, 1, 0)
                                        ProgressKnob.Position = UDim2.new(pct, -5, 0.5, -5)
                                        TimeCurrent.Text = formatSeconds(pos)
                                        TimeTotal.Text = formatSeconds(len)
                                        
                                        if pos >= len - 0.5 then
                                            prestineDisconnect()
                                            if currentQueueIndex < #sessionQueue then
                                                currentQueueIndex = currentQueueIndex + 1
                                                playSelectedQueueIndex()
                                            else
                                                GlobalSound:Stop()
                                                PauseBtn.Text = "▶ PLAY"
                                            end
                                        end
                                    else
                                        ProgressBar.Size = UDim2.new(0, 0, 1, 0)
                                        TimeCurrent.Text = formatSeconds(pos)
                                    end
                                end
                            end)
                        else
                            networkStreamLoadingActive = false
                            LoaderText.Text = "❌ Stream Injection Error"
                            StatusText.Text = "❌ Sound playback failed: " .. tostring(playErr)
                        end
                    else
                        networkStreamLoadingActive = false
                        LoaderText.Text = "❌ Asset Loading Error"
                        StatusText.Text = "❌ getcustomasset block failed. Try different exploit."
                    end
                else
                    networkStreamLoadingActive = false
                    LoaderText.Text = "❌ Download Cache Error"
                    StatusText.Text = "❌ Failed to fetch binary stream from link."
                end
            else
                if networkStreamLoadingActive then
                    networkStreamLoadingActive = false
                    LoaderText.Text = "❌ Server Payload Refused"
                    if not string.find(StatusText.Text, "API Error") then
                        StatusText.Text = "❌ API Payload Error: Timeout or blocked by host."
                    end
                end
            end
        end)
    end

    local function adjustSeekTime(inputObj)
        if GlobalSound.TimeLength > 0 then
            local sizeX = ProgressContainer.AbsoluteSize.X
            local offsetX = inputObj.Position.X - ProgressContainer.AbsolutePosition.X
            local pct = math.clamp(offsetX / sizeX, 0, 1)
            
            ProgressBar.Size = UDim2.new(pct, 0, 1, 0)
            ProgressKnob.Position = UDim2.new(pct, -5, 0.5, -5)
            GlobalSound.TimePosition = pct * GlobalSound.TimeLength
            TimeCurrent.Text = formatSeconds(GlobalSound.TimePosition)
        end
    end

