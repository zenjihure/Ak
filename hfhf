    local function handleSearchExecutionFlow()
        local query = SearchInput.Text:match("^%s*(.-)%s*$")
        if query == "" or networkStreamLoadingActive then return end
        
        StatusText.Text = "🔍 Dispatching Cluster Node Request queries..."
        StatusText.TextColor3 = Color3.fromRGB(255, 0, 127)
        
        for _, child in pairs(ResultsScroll:GetChildren()) do
            if child:IsA("Frame") or child:IsA("TextLabel") then child:Destroy() end
        end
        sessionQueue = {}
        local encoded = f:UrlEncode(query)
        
        task.spawn(function()
            local url = "https://" .. searchHost .. "/ytsearch/?query=" .. encoded
            local ok, res = pcall(function()
                return n({
                    Url = url,
                    Method = "GET",
                    Headers = {
                        ["X-RapidAPI-Host"] = searchHost,
                        ["X-RapidAPI-Key"] = getSecureKey(),
                        ["Content-Type"] = "application/json"
                    }
                })
            end)
            
            if ok and res and res.StatusCode == 200 then
                local decodeOk, parsedData = pcall(function() return f:JSONDecode(res.Body) end)
                if decodeOk and parsedData then
                    local rawList = parsedData.results or parsedData.videos or parsedData.items or parsedData
                    
                    if type(rawList) == "table" and #rawList > 0 then
                        local logicalPositionIndex = 1
                        for _, node in ipairs(rawList) do
                            if isSongTooLong(node) then continue end
                            
                            local vId = type(node.id) == "table" and (node.id.videoId or node.id.video_id) or (node.id or node.videoId or node.video_id)
                            local t_name = node.title or node.name
                            local ch = node.channel or node.author or node.uploaderName or "YouTube Creator"
                            local dur = node.duration or node.durationText or node.length or node.lengthText or "03:45"
                            
                            if t_name and vId then
                                local trackData = {title = t_name, channel = ch, id = vId, duration = dur}
                                table.insert(sessionQueue, trackData)
                                renderSongCard(t_name, ch, vId, dur, logicalPositionIndex)
                                logicalPositionIndex = logicalPositionIndex + 1
                                if logicalPositionIndex > 12 then break end
                            end
                        end
                        StatusText.Text = "✅ Query Matrix loaded with " .. #sessionQueue .. " active stream tracks under 7 mins."
                        StatusText.TextColor3 = Color3.fromRGB(0, 255, 255)
                    else
                        StatusText.Text = "❌ Zero Payload Sync: Check search syntax parameter nodes."
                        StatusText.TextColor3 = Color3.fromRGB(255, 0, 127)
                    end
                else
                    StatusText.Text = "❌ API Error: Response was not valid JSON (Rate Limited?)"
                    StatusText.TextColor3 = Color3.fromRGB(255, 0, 127)
                end
            else
                StatusText.Text = "❌ Server Network Cluster Fault or Key Lock Validation Failed."
                StatusText.TextColor3 = Color3.fromRGB(255, 0, 127)
            end
        end)
    end

